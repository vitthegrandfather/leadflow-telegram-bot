# Telegram bot token from @BotFather. Required to run the bot.
BOT_TOKEN=

# Comma-separated Telegram user IDs that may use /admin.
ADMIN_IDS=123456789

# Async SQLAlchemy URL. SQLite is the default local demonstration database.
DATABASE_URL=sqlite+aiosqlite:///./data/leadflow.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
